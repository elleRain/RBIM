# Cache static map assets in the browser (GeoJSON, JS, CSS, tiles if added later).
<IfModule mod_headers.c>
  <FilesMatch "\.(geojson|js|css|png|jpg|webp)$">
    Header set Cache-Control "public, max-age=604800, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/geo+json application/json text/javascript text/css
</IfModule>
